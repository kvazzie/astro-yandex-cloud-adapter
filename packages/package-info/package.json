{
	"name": "@astro-yandex-cloud/package-info",
	"version": "0.0.0",
	"private": true,
	"description": "Read a module's package name and version from its nearest package.json",
	"type": "module",
	"license": "MIT",
	"sideEffects": false,
	"engines": {
		"node": ">=22.12.0"
	},
	"exports": {
		".": {
			"types": "./index.d.ts",
			"import": "./src/index.js"
		}
	},
	"scripts": {
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"devDependencies": {
		"@types/node": "^24.2.0",
		"typescript": "^5.9.2"
	}
}
