{
  "name": "@astro-yandex-cloud/adapter",
  "version": "0.1.0",
  "description": "Astro adapter for Yandex Cloud Object Storage and Cloud Functions",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astro-yandex-cloud/adapter.git",
    "directory": "packages/adapter"
  },
  "homepage": "https://github.com/astro-yandex-cloud/adapter#readme",
  "bugs": "https://github.com/astro-yandex-cloud/adapter/issues",
  "keywords": [
    "astro",
    "adapter",
    "yandex-cloud",
    "serverless",
    "cloud-functions"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./deployment-manifest": {
      "types": "./dist/deployment-manifest.d.ts",
      "import": "./dist/deployment-manifest.js"
    },
    "./deployment-manifest.schema.json": "./dist/deployment-manifest.schema.json",
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@effect/platform": "^0.97.2",
    "@effect/platform-node": "^0.108.2",
    "acorn": "^8.18.0",
    "ajv": "^8.20.0",
    "effect": "^3.22.2",
    "effectify": "^0.3.1",
    "tinyglobby": "^0.2.17"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "astro": "^7.1.0"
  },
  "devDependencies": {
    "astro": "^7.1.0",
    "pkg-types": "^2.3.3",
    "tsdown": "^0.15.1",
    "typescript": "^5.9.2",
    "vite": "^8.0.13"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
