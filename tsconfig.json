{
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"allowJs": false,
		"declaration": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitOverride": true,
		"noUncheckedIndexedAccess": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2023",
		"types": ["node", "vitest/globals"]
	},
	"include": [
		"packages/adapter/src/**/*.ts",
		"packages/adapter/src/**/.*.ts",
		"packages/function-runtime-bridge/src/**/*.ts",
		"packages/function-runtime-bridge/src/**/.*.ts",
		"packages/function-runtime-bridge/*.ts",
		"packages/adapter/*.ts",
		"tests/unit/**/*.ts",
		"tests/integration/**/*.ts",
		"*.ts",
		"packages/targets/src/**/*.ts",
		"packages/targets/*.ts",
		"packages/deployment-manifest/src/**/*.ts",
		"packages/deployment-manifest/src/**/.*.ts",
		"packages/deployment-manifest/*.ts"
	]
}
